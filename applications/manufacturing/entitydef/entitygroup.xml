<!--
    Entity group configuration for Manufacturing schema separation (Phase 1G).

    This file assigns manufacturing-owned entities to the "org.apache.ofbiz.manufacturing"
    entity group. When a dedicated datasource is configured for this group in
    entityengine.xml, these entities will be served from a separate database schema,
    completing the data-layer decoupling of the Manufacturing module.

    Until a separate datasource is configured, all entities fall back to the default
    "org.apache.ofbiz" group/datasource, so this file is safe to deploy incrementally.

    Manufacturing-owned entities (8 total):
      - ProductManufacturingRule  (BOM substitution/configuration rules)
      - TechDataCalendar          (machine availability calendar)
      - TechDataCalendarWeek      (weekly capacity definitions)
      - TechDataCalendarExcDay    (daily calendar exceptions)
      - TechDataCalendarExcWeek   (weekly calendar exceptions)
      - MrpEvent                  (MRP planning events)
      - MrpEventType              (MRP event type enumeration)
      - MrpEventView              (MRP event view entity - follows MrpEvent)
-->
<entitygroup xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitygroup.xsd">

    <!-- ========================================================= -->
    <!-- org.apache.ofbiz.manufacturing.bom                        -->
    <!-- ========================================================= -->
    <entity-group group="org.apache.ofbiz.manufacturing" entity="ProductManufacturingRule"/>

    <!-- ========================================================= -->
    <!-- org.apache.ofbiz.manufacturing.techdata                   -->
    <!-- ========================================================= -->
    <entity-group group="org.apache.ofbiz.manufacturing" entity="TechDataCalendar"/>
    <entity-group group="org.apache.ofbiz.manufacturing" entity="TechDataCalendarWeek"/>
    <entity-group group="org.apache.ofbiz.manufacturing" entity="TechDataCalendarExcDay"/>
    <entity-group group="org.apache.ofbiz.manufacturing" entity="TechDataCalendarExcWeek"/>

    <!-- ========================================================= -->
    <!-- org.apache.ofbiz.manufacturing.mrp                        -->
    <!-- ========================================================= -->
    <entity-group group="org.apache.ofbiz.manufacturing" entity="MrpEvent"/>
    <entity-group group="org.apache.ofbiz.manufacturing" entity="MrpEventType"/>

</entitygroup>
